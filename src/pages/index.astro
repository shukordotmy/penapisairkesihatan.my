---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guides, site, whatsappUrl } from '../data/site';

const title = 'Penapis Air Kesihatan | Jualan & Servis Pasir Gudang';
const description = 'Jualan dan servis sistem RO, mineral dan dispenser air di Pasir Gudang. Servis penapis indoor dan outdoor disemak mengikut model dan keadaan.';

const services = [
  {
    number: '01',
    title: 'Penapis RO & mineral',
    copy: 'Jualan dan servis mengikut ruang, penggunaan dan model.',
    href: '/penapis-air-rumah/',
  },
  {
    number: '02',
    title: 'Dispenser air',
    copy: 'Jualan, pemeriksaan unit dan semakan filter gantian.',
    href: '/penapis-air-rumah/',
  },
  {
    number: '03',
    title: 'Penapis indoor & outdoor',
    copy: 'Servis unit sedia ada di dalam rumah atau pada laluan air utama.',
    href: '/servis-penapis-air-pasir-gudang/',
  },
  {
    number: '04',
    title: 'Filter & komponen',
    copy: 'Semakan keserasian berdasarkan gambar, jenama dan model.',
    href: '/tukar-filter/',
  },
];
---

<BaseLayout title={title} description={description} path="/">
  <section class="home-hero">
    <div class="page-shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">Taman Cahaya Masai · Pasir Gudang</p>
        <h1>Jualan dan servis penapis air <em>di Pasir Gudang.</em></h1>
        <p class="home-deck">Kami menjual dan menservis sistem RO, mineral dan dispenser air, serta menerima pertanyaan servis untuk penapis rumah indoor dan outdoor.</p>
        <div class="cta-row">
          <a class="button" href={whatsappUrl('Salam, saya ingin bertanya tentang produk atau servis. Lokasi: ____. Jenama/model: ____. Keperluan atau masalah: ____.')} target="_blank" rel="noopener">
            Tanya di WhatsApp <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-secondary" href={`tel:${site.phoneHref}`}>Telefon kami</a>
        </div>
        <p class="hero-helper">Hantar gambar dan label model jika ada.</p>
      </div>

      <figure class="home-hero-photo">
        <div class="home-hero-photo-frame">
          <img
            src="/home-products-hot-cold-hero-v3.webp"
            srcset="/home-products-hot-cold-hero-768.webp 768w, /home-products-hot-cold-hero-1200.webp 1200w, /home-products-hot-cold-hero-v3.webp 1536w"
            sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 808px) calc(100vw - 48px), (max-width: 980px) 760px, (max-width: 1228px) calc(50vw - 24px), 590px"
            width="1536"
            height="1024"
            alt="Ilustrasi dispenser air tanpa jenama bersama contoh filter seramik, karbon, sedimen dan membran RO"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="home-hero-caption">Ilustrasi kategori produk tanpa jenama. Ia bukan gambar produk dalam stok atau model semasa; sahkan model, spesifikasi dan ketersediaan sebelum membeli.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="local-title">
    <div class="page-shell premises-story">
      <figure class="business-photo">
        <img
          src="/business-storefront-blue.webp"
          srcset="/business-storefront-blue-768.webp 768w, /business-storefront-blue-1200.webp 1200w, /business-storefront-blue.webp 1448w"
          sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 900px) calc(100vw - 48px), (max-width: 1228px) calc(54.6vw - 29px), 642px"
          width="1448"
          height="1086"
          alt="Premis Penapis Air Kesihatan di Jalan Intan 12, Taman Cahaya Masai, Pasir Gudang"
          loading="lazy"
          decoding="async"
        />
        <figcaption><span>Lokasi sebenar</span><p>Gambar terdahulu premis yang diperkemas untuk web. Produk, jenama dan stok semasa perlu disahkan.</p></figcaption>
      </figure>
      <div>
        <p class="eyebrow">Perniagaan tempatan</p>
        <h2 id="local-title">Penapis Air Kesihatan di Taman Cahaya Masai.</h2>
        <p class="lede">Hubungi kami di {site.address.display}. Perniagaan ini dikendalikan oleh {site.legalName} ({site.registration}), sebuah perniagaan Johor yang dimulakan pada {site.started}.</p>
        <p>Tarikh tersebut merujuk kepada perniagaan berdaftar. Sebelum datang, sahkan waktu, model, stok atau kesesuaian servis melalui WhatsApp atau telefon.</p>
        <div class="cta-row">
          <a class="button button-secondary" href={site.directions} target="_blank" rel="noopener">Arah ke lokasi <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/tentang/">Tentang perniagaan <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section id="produk-servis" class="home-services" aria-labelledby="services-title">
    <div class="page-shell home-services-grid">
      <div class="home-section-intro">
        <p class="eyebrow">Produk & servis</p>
        <h2 id="services-title">Apa yang boleh kami bantu.</h2>
        <p>Pilih kategori yang paling hampir. Jenama, model, stok dan skop kerja akan disemak sebelum pengesahan.</p>
      </div>

      <div class="service-menu">
        {services.map((service) => (
          <a href={service.href}>
            <span>{service.number}</span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.copy}</p>
            </div>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-enquiry" aria-labelledby="enquiry-title">
    <div class="page-shell home-enquiry-grid">
      <div>
        <p class="eyebrow eyebrow-light">Semakan awal yang mudah</p>
        <h2 id="enquiry-title">Hantar gambar. Kami semak dahulu.</h2>
      </div>
      <div class="home-enquiry-action">
        <p>Sertakan lokasi, gambar penuh unit dan label model. Maklumat ringkas ini membantu kami memberi langkah seterusnya dengan lebih tepat.</p>
        <a class="button button-paper" href={whatsappUrl('Salam, saya ingin semak penapis air. Lokasi: ____. Jenama/model: ____. Keperluan atau masalah: ____.')} target="_blank" rel="noopener">
          Mulakan pertanyaan <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-guides" aria-labelledby="guides-title">
    <div class="page-shell home-guides-grid">
      <div class="home-section-intro">
        <p class="eyebrow">Panduan ringkas</p>
        <h2 id="guides-title">Baca sebelum memilih.</h2>
        <a class="text-link" href="/panduan/">Semua panduan <span aria-hidden="true">→</span></a>
      </div>
      <div class="guide-list">
        {guides.map((guide) => (
          <a href={`/panduan/${guide.slug}/`}>
            <span>{guide.category} · {guide.readingTime}</span>
            <h3>{guide.title}</h3>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
