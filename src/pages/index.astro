---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guides, site, whatsappUrl } from '../data/site';

const title = 'Penapis Air Pasir Gudang | Jualan & Servis';
const description = 'Jualan dan servis penapis air RO, sistem mineral, dispenser serta penapis indoor dan outdoor di Taman Cahaya Masai, Pasir Gudang.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  inLanguage: 'ms-MY',
  publisher: { '@id': `${site.url}/#business` },
};

const services = [
  {
    number: '01',
    title: 'Penapis RO & mineral',
    copy: 'Sistem air minuman mengikut ruang dan cara penggunaan.',
    href: '/penapis-air-rumah/',
  },
  {
    number: '02',
    title: 'Dispenser air',
    copy: 'Jualan, pemeriksaan unit dan filter gantian.',
    href: '/servis-penapis-air-pasir-gudang/',
  },
  {
    number: '03',
    title: 'Penapis indoor & outdoor',
    copy: 'Servis sistem di dalam rumah atau pada laluan air utama.',
    href: '/servis-penapis-air-pasir-gudang/',
  },
  {
    number: '04',
    title: 'Filter & komponen',
    copy: 'Semakan keserasian berdasarkan gambar, jenama dan model.',
    href: '/tukar-filter/',
  },
];
---

<BaseLayout title={title} description={description} path="/" schema={schema}>
  <section class="home-hero">
    <div class="page-shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">Taman Cahaya Masai · Pasir Gudang</p>
        <h1>Penapis air untuk rumah. <em>Jualan & servis.</em></h1>
        <p class="home-deck">RO, sistem mineral, dispenser serta penapis indoor dan outdoor—semak keperluan anda terus dengan kami.</p>
        <div class="cta-row">
          <a class="button" href={whatsappUrl('Salam, saya ingin bertanya tentang produk atau servis. Lokasi: ____. Jenama/model: ____. Keperluan atau masalah: ____.')} target="_blank" rel="noopener">
            Tanya di WhatsApp <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-secondary" href={`tel:${site.phoneHref}`}>Telefon kami</a>
        </div>
        <p class="hero-helper">Hantar gambar dan label model jika ada.</p>
      </div>

      <figure class="home-hero-photo">
        <div class="home-hero-photo-frame">
          <img
            src="/home-products-hot-cold-hero-v3.webp"
            width="1536"
            height="1024"
            alt="Dispenser air panas dan sejuk tanpa jenama bersama filter seramik, karbon, sedimen dan membran RO"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </section>

  <section id="produk-servis" class="home-services" aria-labelledby="services-title">
    <div class="page-shell home-services-grid">
      <div class="home-section-intro">
        <p class="eyebrow">Produk & servis</p>
        <h2 id="services-title">Apa yang boleh kami bantu.</h2>
        <p>Pilih kategori yang paling hampir. Jenama, model, stok dan skop kerja akan disemak sebelum pengesahan.</p>
      </div>

      <div class="service-menu">
        {services.map((service) => (
          <a href={service.href}>
            <span>{service.number}</span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.copy}</p>
            </div>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-enquiry" aria-labelledby="enquiry-title">
    <div class="page-shell home-enquiry-grid">
      <div>
        <p class="eyebrow eyebrow-light">Semakan awal yang mudah</p>
        <h2 id="enquiry-title">Hantar gambar. Kami semak dahulu.</h2>
      </div>
      <div class="home-enquiry-action">
        <p>Sertakan lokasi, gambar penuh unit dan label model. Maklumat ringkas ini membantu kami memberi langkah seterusnya dengan lebih tepat.</p>
        <a class="button button-paper" href={whatsappUrl('Salam, saya ingin semak penapis air. Lokasi: ____. Jenama/model: ____. Keperluan atau masalah: ____.')} target="_blank" rel="noopener">
          Mulakan pertanyaan <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-guides" aria-labelledby="guides-title">
    <div class="page-shell home-guides-grid">
      <div class="home-section-intro">
        <p class="eyebrow">Panduan ringkas</p>
        <h2 id="guides-title">Baca sebelum memilih.</h2>
        <a class="text-link" href="/panduan/">Semua panduan <span aria-hidden="true">→</span></a>
      </div>
      <div class="guide-list">
        {guides.map((guide) => (
          <a href={`/panduan/${guide.slug}/`}>
            <span>{guide.category} · {guide.readingTime}</span>
            <h3>{guide.title}</h3>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
