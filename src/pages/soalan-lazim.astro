---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQList from '../components/FAQList.astro';
import ContactBand from '../components/ContactBand.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { breadcrumbSchema, site } from '../data/site';

const title = 'Soalan Lazim Penapis Air, Servis & Filter | Pasir Gudang';
const description = 'Jawapan terus tentang pemilihan penapis air, semakan model, servis sistem lama, filter gantian, harga, lawatan dan lokasi perniagaan di Pasir Gudang.';
const path = '/soalan-lazim/';
const crumbs = [{ label: 'Laman utama', href: '/' }, { label: 'Soalan lazim', href: path }];
const faqs = [
  { question: 'Apakah perkhidmatan yang disediakan?', answer: 'Kami menjual dan menservis penapis RO, sistem mineral dan dispenser air, serta menservis penapis indoor dan outdoor. Unit sedia ada atau lama juga boleh dipertimbangkan selepas semakan jenama, model, keadaan dan alat ganti.' },
  { question: 'Apakah beza penapis indoor dan outdoor?', answer: 'Penapis indoor biasanya digunakan pada satu titik seperti sinki, paip minuman atau dispenser. Penapis outdoor biasanya dipasang pada laluan masuk air sebelum air diagihkan ke dalam rumah. Susunan sebenar perlu dikenal pasti melalui gambar dan lokasi pemasangan.' },
  { question: 'Adakah semua jenama boleh diservis?', answer: 'Tidak semestinya. Hantar gambar unit, label model dan masalah. Keserasian komponen serta ketersediaan perlu diperiksa bagi setiap sistem.' },
  { question: 'Berapakah harga penapis air?', answer: 'Harga bergantung pada model, fungsi, pemasangan, penyelenggaraan dan stok semasa. Laman ini tidak memaparkan angka yang belum disahkan. Minta sebut harga berdasarkan keperluan anda.' },
  { question: 'Berapakah harga servis atau tukar filter?', answer: 'Kos bergantung pada model, filter atau komponen, keadaan unit dan skop kerja. Gambar boleh membantu semakan awal, tetapi pemeriksaan lanjut mungkin diperlukan.' },
  { question: 'Bagaimana saya mengenal pasti model?', answer: 'Cari label pada belakang, bawah atau sisi unit. Ambil gambar yang jelas pada jenama, nombor model dan spesifikasi. Jangan kongsi nombor siri jika tidak diperlukan.' },
  { question: 'Bila filter perlu ditukar?', answer: 'Ikut jadual pengeluar untuk model tepat dan pertimbangkan penggunaan serta keadaan operasi. Jangan gunakan satu tempoh umum untuk semua sistem.' },
  { question: 'Boleh datang terus ke lokasi?', answer: 'Boleh dapatkan arah ke premis di Jalan Intan 12, tetapi hubungi dahulu kerana waktu dalam sumber awam tidak konsisten dan stok atau kesesuaian model perlu disahkan.' },
  { question: 'Adakah servis ke rumah tersedia?', answer: 'Servis merangkumi sistem yang dipasang di dalam dan di luar rumah. Ketersediaan kunjungan serta liputan kawasan pula perlu disemak berdasarkan lokasi dan skop kerja. Hantar kawasan anda melalui WhatsApp.' },
  { question: 'Adakah penapis air menjamin air bebas semua bahan cemar?', answer: 'Tidak. Keupayaan berbeza mengikut teknologi, model dan bukti ujian. Pensijilan untuk satu standard atau bahan tidak bermaksud sistem menyingkirkan semua bahan cemar.' },
  { question: 'Apakah maklumat terbaik untuk dihantar di WhatsApp?', answer: 'Nyatakan lokasi, tujuan pembelian atau masalah, jenama/model, tarikh servis terakhir jika diketahui, serta gambar unit dan label yang jelas.' },
];
---

<BaseLayout title={title} description={description} path={path} schema={breadcrumbSchema(crumbs)}>
  <div class="page-shell"><Breadcrumbs items={crumbs} /></div>
  <header class="page-hero"><div class="page-shell page-hero-grid"><div><p class="eyebrow">Soalan lazim</p><h1>Soalan lazim tentang penapis air, servis dan filter.</h1><p class="page-hero-copy">Model, keadaan dan lokasi boleh mengubah cadangan. Ketepatan lebih penting daripada jawapan cepat yang terlalu umum.</p></div><aside class="page-hero-aside"><strong>Tidak jumpa jawapan?</strong><p>Hubungi terus melalui WhatsApp dan sertakan gambar sistem anda.</p><a class="text-link" href={`tel:${site.phoneHref}`}>Telefon {site.phoneDisplay}</a></aside></div></header>
  <section class="section surface-white" aria-labelledby="faq-list-title">
    <div class="page-shell faq-wide">
      <div class="section-heading">
        <div><p class="eyebrow">Jawapan ringkas</p><h2 id="faq-list-title">Pertanyaan yang biasa diterima sebelum jualan atau servis.</h2></div>
        <p>Gunakan jawapan ini sebagai persediaan awal. Maklumat model, keadaan unit dan lokasi masih perlu disemak untuk pertanyaan sebenar.</p>
      </div>
      <FAQList items={faqs} />
    </div>
  </section>
  <div class="page-shell">
    <RelatedLinks
      heading="Lihat jawapan yang lebih khusus"
      items={[
        { href: '/penapis-air-rumah/', label: 'Pemilihan', title: 'Banding penapis air RO, mineral dan dispenser' },
        { href: '/tukar-filter/', label: 'Filter gantian', title: 'Kenal pasti model sebelum membeli cartridge' },
        { href: '/servis-penapis-air-pasir-gudang/', label: 'Servis', title: 'Semak servis penapis air di Pasir Gudang' },
      ]}
    />
  </div>
  <ContactBand heading="Ada soalan yang khusus kepada model anda?" copy="Hantar gambar dan butiran ringkas. Kami akan semak konteks sebelum memberi cadangan." message="Salam, saya ada soalan tentang penapis air. Lokasi: ____. Jenama/model: ____. Soalan: ____." />
</BaseLayout>
