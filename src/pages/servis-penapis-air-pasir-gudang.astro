---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQList from '../components/FAQList.astro';
import ContactBand from '../components/ContactBand.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { absoluteUrl, breadcrumbSchema, site, whatsappUrl } from '../data/site';

const title = 'Servis Penapis Air Pasir Gudang | Penapis Air Kesihatan';
const description = 'Servis penapis RO, sistem mineral, dispenser serta penapis indoor dan outdoor di Pasir Gudang. Hantar gambar dan model untuk semakan.';
const path = '/servis-penapis-air-pasir-gudang/';
const crumbs = [{ label: 'Laman utama', href: '/' }, { label: 'Servis penapis air', href: path }];
const faqs = [
  { question: 'Jenis sistem apa yang boleh diservis?', answer: 'Skop merangkumi penapis RO, sistem mineral, dispenser air serta penapis indoor dan outdoor. Unit lama atau sedia ada boleh dipertimbangkan, tetapi keserasian tetap bergantung pada jenama, model, keadaan dan alat ganti.' },
  { question: 'Adakah anda servis penapis di luar dan di dalam rumah?', answer: 'Ya, pertanyaan servis boleh dibuat untuk penapis yang dipasang di dalam rumah dan sistem outdoor pada laluan masuk air. Hantar gambar keseluruhan pemasangan supaya jenis sistem dapat dikenal pasti.' },
  { question: 'Adakah anda datang ke rumah?', answer: 'Pilihan kunjungan dan liputan perlu disahkan mengikut lokasi serta skop kerja. Kongsi kawasan anda melalui WhatsApp sebelum membuat perancangan.' },
  { question: 'Boleh dapat harga sebelum servis?', answer: 'Kami boleh memahami masalah melalui gambar dan maklumat awal, tetapi harga tepat mungkin memerlukan pemeriksaan sistem dan pengesahan komponen.' },
];
const schema = [
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org', '@type': 'Service', name: 'Servis penapis air di Pasir Gudang',
    '@id': `${absoluteUrl(path)}#service`, url: absoluteUrl(path), serviceType: 'Servis penapis air rumah',
    provider: { '@id': `${site.url}/#business` }, mainEntityOfPage: { '@id': `${absoluteUrl(path)}#webpage` }, description,
  },
];
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <div class="page-shell"><Breadcrumbs items={crumbs} /></div>
  <header class="page-hero">
    <div class="page-shell page-hero-grid">
      <div>
        <p class="eyebrow">Servis penapis air · Pasir Gudang</p>
        <h1>Servis penapis air di Pasir Gudang.</h1>
        <p class="page-hero-copy">Daripada unit air minuman hingga penapis laluan masuk rumah, termasuk unit sedia ada atau lama, kami semak model, susunan sistem, keadaan yang dilaporkan dan kesesuaian komponen sebelum mencadangkan langkah seterusnya.</p>
      </div>
      <aside class="page-hero-aside">
        <strong>Hantar 3 perkara</strong>
        <p>Gambar penuh unit, gambar label model dan penerangan ringkas masalah.</p>
        <a class="button" href={whatsappUrl('Salam, saya perlukan servis penapis air. Lokasi: ____. Jenama/model: ____. Masalah: ____.')} target="_blank" rel="noopener">Semak servis di WhatsApp <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </header>

  <section class="section surface-white" aria-labelledby="systems-title">
    <div class="page-shell">
      <div class="section-heading">
        <div><p class="eyebrow">Jenis sistem</p><h2 id="systems-title">Kenal pasti kategori sebelum menilai servis.</h2></div>
        <p>Nama kategori membantu memulakan perbualan, tetapi nombor model, susunan filter dan keadaan pemasangan menentukan kerja sebenar.</p>
      </div>
      <div class="info-grid">
        <article class="info-item"><span>01 · RO</span><h3>Penapis reverse osmosis</h3><p>Semakan boleh melibatkan filter, membran, aliran, tangki, pam atau sambungan mengikut reka bentuk unit.</p></article>
        <article class="info-item"><span>02 · Mineral</span><h3>Sistem penapis mineral</h3><p>Kenal pasti model dan peringkat filter dahulu; istilah “mineral” sahaja tidak menentukan komponen atau jadual servis.</p></article>
        <article class="info-item"><span>03 · Dispenser</span><h3>Dispenser air</h3><p>Kongsi gambar paparan, keluaran air dan label unit jika terdapat kebocoran, aliran berubah atau operasi luar biasa.</p></article>
        <article class="info-item"><span>04 · Indoor</span><h3>Penapis dalam rumah</h3><p>Termasuk sistem pada sinki, bawah sinki, kaunter atau titik minum, bergantung pada pemasangan sebenar.</p></article>
        <article class="info-item"><span>05 · Outdoor</span><h3>Penapis luar rumah</h3><p>Untuk sistem pada laluan masuk air utama, sertakan gambar housing, injap, paip dan ruang sekeliling.</p></article>
        <article class="info-item"><span>06 · Sedia ada</span><h3>Unit lama atau jenama lain</h3><p>Boleh dihantar untuk semakan awal tanpa janji bahawa setiap model atau alat ganti tersedia.</p></article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="symptoms-title">
    <div class="page-shell">
      <div class="section-heading">
        <div><p class="eyebrow">Bila patut bertanya</p><h2 id="symptoms-title">Perubahan ini wajar diperiksa.</h2></div>
        <p>Satu tanda tidak semestinya menunjukkan satu punca. Elakkan membeli komponen secara rawak sebelum model dan keadaan unit dikenal pasti.</p>
      </div>
      <div class="info-grid">
        <article class="info-item"><span>01</span><h3>Aliran makin perlahan</h3><p>Boleh berkait dengan filter, tekanan, paip atau komponen lain. Bandingkan dengan keadaan biasa sistem.</p></article>
        <article class="info-item"><span>02</span><h3>Ada titisan atau kebocoran</h3><p>Tutup bekalan jika kebocoran serius dan jangan paksa sambungan. Ambil gambar kawasan yang bocor.</p></article>
        <article class="info-item"><span>03</span><h3>Bunyi atau operasi luar biasa</h3><p>Catat bila bunyi berlaku dan sama ada unit mempunyai pam, tangki atau dispenser elektrik.</p></article>
        <article class="info-item"><span>04</span><h3>Sudah lama tidak diperiksa</h3><p>Semak rekod servis dan jadual pengeluar. Tempoh penggantian bukan sama untuk semua model.</p></article>
        <article class="info-item"><span>05</span><h3>Selepas berpindah atau disimpan</h3><p>Sambungan, hos dan keadaan dalaman mungkin memerlukan pemeriksaan sebelum digunakan semula.</p></article>
        <article class="info-item"><span>06</span><h3>Perubahan rasa atau bau</h3><p>Hentikan penggunaan jika ada perubahan yang membimbangkan dan dapatkan pemeriksaan yang sesuai.</p></article>
      </div>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="scope-title">
    <div class="page-shell split-content">
      <div>
        <p class="eyebrow">Skop ditentukan selepas semakan</p>
        <h2 id="scope-title">Kami tidak menjanjikan “semua jenama” tanpa melihat unit.</h2>
        <p class="lede">Pendekatan ini melindungi masa dan kos anda. Sesetengah sistem memerlukan cartridge, sambungan atau komponen khusus yang mungkin tidak serasi antara model.</p>
      </div>
      <ul class="fact-list">
        <li><strong>Perlu</strong><span>Gambar penuh sistem</span></li>
        <li><strong>Perlu</strong><span>Jenama dan nombor model</span></li>
        <li><strong>Berguna</strong><span>Tarikh servis terakhir</span></li>
        <li><strong>Berguna</strong><span>Video ringkas aliran atau kebocoran</span></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="checks-title">
    <div class="page-shell">
      <div class="section-heading">
        <div><p class="eyebrow">Semakan mengikut unit</p><h2 id="checks-title">Masalah yang sama boleh datang daripada komponen berbeza.</h2></div>
        <p>Maklumat ini membantu membezakan keperluan penyelenggaraan biasa daripada pemeriksaan yang lebih khusus.</p>
      </div>
      <div class="comparison-list" role="list">
        {['Filter, cartridge atau membran yang digunakan', 'Aliran dan tekanan sebelum serta selepas sistem', 'Kebocoran pada housing, hos, paip atau sambungan', 'Pam, tangki dan injap jika sistem menggunakannya', 'Operasi dispenser, paparan atau bunyi luar biasa', 'Injap atau proses backwash untuk sistem outdoor jika berkaitan'].map((item, index) => (
          <div role="listitem"><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></div>
        ))}
      </div>
      <p class="source-note">Senarai ini menerangkan perkara yang boleh diperiksa, bukan janji bahawa semua pembaikan atau komponen tersedia untuk setiap model.</p>
    </div>
  </section>

  <section class="section surface-mint" aria-labelledby="service-process-title">
    <div class="page-shell">
      <div class="section-heading"><div><p class="eyebrow">Aliran pertanyaan</p><h2 id="service-process-title">Semak dahulu, kemudian tentukan.</h2></div><p>Maklumat awal membantu membezakan pertanyaan filter, komponen dan pemeriksaan sistem.</p></div>
      <div class="numbered-list">
        <article class="numbered-item"><h3>Terangkan masalah</h3><p>Nyatakan apa yang berubah, sejak bila dan apa yang sudah anda cuba.</p></article>
        <article class="numbered-item"><h3>Kenal pasti unit</h3><p>Kami semak label model, susunan filter dan maklumat visual yang tersedia.</p></article>
        <article class="numbered-item"><h3>Sahkan pilihan</h3><p>Kami maklumkan jika perlu datang ke lokasi, pemeriksaan lanjut atau langkah lain.</p></article>
      </div>
    </div>
  </section>

  <section class="section surface-white" aria-labelledby="service-faq-title">
    <div class="page-shell faq-layout"><div class="faq-intro"><p class="eyebrow">Sebelum menempah</p><h2 id="service-faq-title">Soalan tentang servis.</h2></div><FAQList items={faqs} /></div>
  </section>

  <div class="page-shell">
    <RelatedLinks
      heading="Kenal pasti masalah sebelum menempah servis"
      items={[
        { href: '/panduan/tanda-penapis-air-perlu-servis/', label: 'Pemeriksaan awal', title: '6 tanda penapis air mungkin perlu diservis' },
        { href: '/tukar-filter/', label: 'Filter gantian', title: 'Semak cartridge dan model sebelum membeli' },
        { href: '/panduan/penapis-air-indoor-atau-outdoor/', label: 'Susunan rumah', title: 'Penapis indoor atau outdoor: apa bezanya?' },
      ]}
    />
  </div>

  <ContactBand heading="Tunjukkan unit anda kepada kami." copy="Satu gambar penuh dan satu gambar label model ialah permulaan terbaik untuk semakan servis." message="Salam, saya perlukan servis penapis air. Lokasi: ____. Jenama/model: ____. Masalah: ____." />
</BaseLayout>
