---
import BaseLayout from '../layouts/BaseLayout.astro';
import { whatsappUrl } from '../data/site';
---

<BaseLayout title="Halaman Tidak Ditemui | Penapis Air Kesihatan" description="Halaman yang anda cari tidak ditemui." path="/404/" noindex={true}>
  <section class="error-page">
    <div class="page-shell error-grid">
      <div><p class="eyebrow">Ralat 404</p><h1>Halaman ini sudah tiada—atau alamatnya tersilap.</h1><p>Kembali ke laman utama atau pilih pautan yang paling hampir dengan maklumat yang anda cari.</p><div class="cta-row"><a class="button" href="/">Kembali ke laman utama</a><a class="button button-secondary" href={whatsappUrl('Salam, saya tidak menjumpai maklumat yang dicari di laman web. Saya ingin bertanya tentang: ____.')} target="_blank" rel="noopener">Tanya melalui WhatsApp</a></div><nav class="error-links" aria-label="Pautan pemulihan"><a href="/penapis-air-rumah/">Penapis air rumah</a><a href="/servis-penapis-air-pasir-gudang/">Servis penapis air</a><a href="/panduan/">Pusat panduan</a></nav></div>
      <div class="error-mark" aria-hidden="true"><span>4</span><i></i><span>4</span></div>
    </div>
  </section>
</BaseLayout>
