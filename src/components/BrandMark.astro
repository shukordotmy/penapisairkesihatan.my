---
interface Props {
  class?: string;
  labelled?: boolean;
  title?: string;
}

const {
  class: className = '',
  labelled = false,
  title = 'Simbol Penapis Air Kesihatan',
} = Astro.props;
---

<img
  class:list={['brand-symbol', className]}
  src="/brand-icon.png"
  width="512"
  height="512"
  alt={labelled ? title : ''}
  aria-hidden={labelled ? undefined : 'true'}
  decoding="async"
/>
