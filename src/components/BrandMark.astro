---
interface Props {
  class?: string;
  labelled?: boolean;
  title?: string;
}

const {
  class: className = '',
  labelled = false,
  title = 'Simbol Penapis Air Kesihatan',
} = Astro.props;
---

<svg
  class:list={['brand-symbol', className]}
  viewBox="0 0 300 360"
  role={labelled ? 'img' : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  aria-label={labelled ? title : undefined}
>
  <path
    class="brand-symbol-navy"
    d="M148 8c-21 59-53 90-80 123-34 41-44 82-33 130 12 49 49 79 98 90-23-22-24-57-5-83 20-27 52-40 80-60 29-20 42-42 38-67-3-23-21-44-41-65-22-23-43-48-57-68Z"
  />
  <path
    class="brand-symbol-aqua"
    d="M252 166c-7 28-24 51-51 67-29 18-56 32-64 59-7 23 2 46 18 60 47 0 87-24 106-63 19-38 14-84-9-123Z"
  />
</svg>
