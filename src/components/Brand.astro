---
interface Props {
  variant?: 'wordmark' | 'primary' | 'reversed' | 'icon';
}

const { variant = 'wordmark' } = Astro.props;
const assets = {
  wordmark: { src: '/brand-wordmark.png', width: 1024, height: 224 },
  primary: { src: '/brand-logo.png', width: 512, height: 345 },
  reversed: { src: '/brand-logo-reversed.png', width: 512, height: 346 },
  icon: { src: '/brand-icon.png', width: 512, height: 512 },
};
const asset = assets[variant];
---

<a class:list={['brand', `brand-${variant}`]} href="/" aria-label="Penapis Air Kesihatan — laman utama">
  <img
    class="brand-logo"
    src={asset.src}
    width={asset.width}
    height={asset.height}
    alt=""
    decoding="async"
  />
</a>
